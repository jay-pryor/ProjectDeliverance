<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Split in two so the API-27-only attribute can live in values-v27 without
      duplicating the rest. minSdk is 24, and android:windowLightNavigationBar
      does not exist below 27 — declaring it in the base theme is a lint error,
      not merely inert.
    -->
    <!--
      Theme.AppCompat, not Theme.AppCompat.DayNight. DayNight follows the
      SYSTEM light/dark setting, so on a phone in light mode it resolved to the
      light theme and the navigation bar came out white. This app has one
      appearance and does not track the system.
    -->
    <style name="BaseNoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!--
          Two mechanisms, because which one applies depends on whether the app
          is actually running edge-to-edge, and Capacitor does nothing either
          way (no setDecorFitsSystemWindows, no bar handling anywhere in
          BridgeActivity).

          If it IS edge-to-edge — Android forces this for targetSdk 35+ — the
          bars are transparent, these two colours are ignored, and what shows
          through is windowBackground until the WebView paints and then the
          WebView itself (android.backgroundColor in capacitor.config.json).

          If it is NOT, these two are what colour the bars, and windowBackground
          only stops the launch flash.

          Setting all three is not belt-and-braces for its own sake: the two
          cases are indistinguishable from the source, and every one of these is
          correct in both.
        -->
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:navigationBarColor">@color/appBackground</item>
        <item name="android:statusBarColor">@color/appBackground</item>

        <!--
          These two are still honoured on API 35+: they set the ICON colour on
          the system bars, not the bar colour. `false` means light icons, which
          is what a near-black background needs.
        -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- What the manifest points at. values-v27 overrides this one. -->
    <style name="AppTheme.NoActionBar" parent="BaseNoActionBar" />


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>