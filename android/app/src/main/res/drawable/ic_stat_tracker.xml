<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for every notification this app posts.

  Without a configured smallIcon the plugin falls back to Android's stock "i"
  glyph, which reads as a system message rather than as this app.

  The mark is the app's own bracket device (`.bracket` in layout.css): a
  top-left and a bottom-right corner, nothing between them. Android masks a
  status-bar icon down to its alpha channel and tints the result with
  `iconColor`, so this is deliberately pure white on transparent — any other
  colour here would simply be discarded.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,3 H11 V5.5 H5.5 V13 H3 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M21,21 H13 V18.5 H18.5 V11 H21 Z" />
</vector>
